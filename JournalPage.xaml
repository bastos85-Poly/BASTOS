<?xml version="1.0" ?><UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Bastos.Native.JournalPage">
 <Grid Margin="0,4,0,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,12,0"><TextBlock Text="Rechercher une opération" Foreground="#AAB8CE" Margin="0,0,0,6"/>
    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" ToolTip="Nom, message, code d’erreur ou référence"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Résultat" Foreground="#AAB8CE" Margin="0,0,0,6"/>
    <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Padding="8,7"/></StackPanel>
   <Button Grid.Column="2" Content="Actualiser" Command="{Binding RefreshCommand}" Style="{DynamicResource QuietButton}" VerticalAlignment="Bottom"/>
  </Grid>
  <StackPanel Grid.Row="1" Margin="0,0,0,12">
   <TextBlock Text="{Binding Summary}" Foreground="#AAB8CE" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Notice}" Foreground="#FFB84D" TextWrapping="Wrap" Margin="0,5,0,0"/>
  </StackPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" Background="#101624" BorderBrush="#263449" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,9">
     <TextBlock Text="{Binding Date}" Foreground="#AAB8CE" FontSize="11"/>
     <TextBlock Text="{Binding Name}" Foreground="#F1F5FF" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5"/>
     <TextBlock Text="{Binding Status}" Foreground="{Binding Color}" TextWrapping="Wrap"/>
    </StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Border Grid.Column="2" Background="#111827" BorderBrush="#263449" BorderThickness="1" CornerRadius="12" Padding="20">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock Text="Résultat de l’opération" FontSize="18" FontWeight="SemiBold" Foreground="#F1F5FF" Margin="0,0,0,16"/>
      <TextBlock Text="Sélectionnez une opération dans la liste. Si la liste est vide, essayez un autre filtre ou consultez le journal texte." Foreground="#AAB8CE" TextWrapping="Wrap">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <StackPanel DataContext="{Binding Selected}">
       <TextBlock Text="{Binding Name}" FontSize="16" Foreground="#F1F5FF" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Date}" Foreground="#AAB8CE" Margin="0,6"/>
       <TextBlock Text="{Binding Status}" Foreground="{Binding Color}" FontWeight="SemiBold" Margin="0,0,0,14" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Outcome}" Foreground="#AAB8CE" TextWrapping="Wrap" Margin="0,0,0,8">
        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Outcome}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
       <TextBlock Text="{Binding Message}" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,16"/>
       <StackPanel>
        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasIssue}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock Text="Prochaine action" Foreground="#AAB8CE" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding NextStep}" Foreground="#FFB84D" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <TextBlock Text="État de cette tentative" Foreground="#AAB8CE" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Effects}" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,16"/>
       </StackPanel>
       <Expander Header="Détails techniques" Foreground="#AAB8CE" Margin="0,8,0,16">
        <StackPanel>
        <ItemsControl ItemsSource="{Binding Checks}"><ItemsControl.ItemTemplate><DataTemplate>
         <TextBlock Text="{Binding}" Foreground="#C4CFE0" TextWrapping="Wrap" Margin="0,0,0,10"/>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBox Text="{Binding TechnicalDetail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="#AAB8CE" Margin="0,10"/>
        </StackPanel>
       </Expander>
      </StackPanel>
      <Button Content="Ouvrir le rapport complet" Command="{Binding OpenReportCommand}" Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Left"/>
      <Border Background="#182235" CornerRadius="8" Padding="12" Margin="0,16,0,0">
       <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <StackPanel>
        <TextBlock Text="Reprendre après vérification" Foreground="#F1F5FF" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding ResumeHint}" Foreground="#AAB8CE" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <WrapPanel>
         <Button x:Name="CheckResumeButton" Content="Vérifier les éléments existants" Command="{Binding CheckResumeCommand}" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,8"/>
         <Button x:Name="ContinueResumeButton" Content="Continuer dans le module" Command="{Binding ContinueInModuleCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,0,8"/>
        </WrapPanel>
        <TextBlock Text="{Binding ResumeStatus}" Foreground="#FFB84D" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <WrapPanel Grid.Row="3" Margin="0,14,0,0">
   <Button x:Name="OpenLogMaintenanceButton" Content="Journaux et fichiers temporaires…" Command="{Binding DataContext.OpenLogMaintenanceCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource SecondaryButton}" Margin="0,0,10,8"/>
   <Button x:Name="OpenDiagnosticExportButton" Content="Exporter un diagnostic…" Command="{Binding DataContext.OpenDiagnosticExportCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource PrimaryButton}" Margin="0,0,10,8"/>
   <Button Content="Bilan après réinstallation" Command="{Binding DataContext.OpenInstallationCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource SecondaryButton}" Margin="0,0,10,8"/>
   <Button Content="Dossier des rapports" Command="{Binding OpenFolderCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,10,8"/>
   <Button Content="Journal texte (anciens messages)" Command="{Binding OpenLegacyCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,10,8"/>
  </WrapPanel>
 </Grid>
</UserControl>