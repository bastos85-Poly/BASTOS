<?xml version="1.0" ?><Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Bastos.Native.RufusInstallWindow" Title="BASTOS — Options de réinstallation" Width="620" Height="790" MinWidth="560" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#111827" Foreground="#EDF2F7">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDF2F7"/><Setter Property="Margin" Value="0,8,0,0"/></Style>
    <Style x:Key="ManualCleanupOption" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Style.Triggers><DataTrigger Binding="{Binding UseCleanBastosInstallation}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="18,9"/><Setter Property="Margin" Value="8,0,0,0"/></Style>
  </Window.Resources>
  <DockPanel Margin="22">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <TextBlock x:Name="ErrorText" Foreground="#FCA5A5" Margin="0,0,0,8"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Annuler" Click="Cancel_Click" IsCancel="True" Style="{DynamicResource QuietButton}"/>
        <Button x:Name="SaveButton" ToolTipService.ShowOnDisabled="True" Content="Enregistrer les options" Click="Save_Click" IsDefault="True" IsEnabled="False"/>
      </StackPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="1. ISO et édition de Windows" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Partition de réinstallation à conserver" Margin="0,14,0,0"/>
        <TextBox x:Name="TargetText" IsReadOnly="True" Text="D: — BASTOS_RECOVERY"/>
        <TextBlock Text="Le plan est lié à ce disque et à ses partitions. Si leur disposition change, vérifie et enregistre le nouveau plan avant de continuer." Foreground="#B6C2D2" Margin="0,6,0,0"/>
        <TextBlock Text="Sélection de démarrage" Margin="0,12,0,0"/>
        <TextBox x:Name="IsoText" IsReadOnly="True"/>
        <TextBlock Text="Édition Windows à installer" Margin="0,12,0,0" FontWeight="SemiBold"/>
        <ComboBox x:Name="EditionCombo" DisplayMemberPath="InstallOptionDisplay" Margin="0,6,0,0" Padding="8" MinHeight="36" IsEnabled="False" SelectionChanged="Edition_SelectionChanged"/>
        <TextBlock x:Name="SaveHint" Style="{DynamicResource ActionHint}" Text="Lecture des éditions de l’ISO en cours. Attends la fin du chargement."/><TextBlock x:Name="EditionStatusText" Text="Lecture des éditions contenues dans l’ISO…" Foreground="#B6C2D2" Margin="0,6,0,0"/>
        <TextBlock Text="Langue de Windows disponible dans cette édition" Margin="0,12,0,0" FontWeight="SemiBold"/>
        <ComboBox x:Name="ImageLanguageCombo" DisplayMemberPath="Display" Margin="0,6,0,0" Padding="8" MinHeight="36" IsEnabled="False" SelectionChanged="ImageLanguage_SelectionChanged"/>
        <TextBlock x:Name="ImageLanguageStatusText" Text="Choisis d’abord l’édition Windows." Foreground="#B6C2D2" Margin="0,6,0,0"/>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,8,0"><TextBlock Text="Schéma de partition"/><TextBox Text="GPT" IsReadOnly="True"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="Système de destination"/><TextBox Text="UEFI" IsReadOnly="True"/></StackPanel>
        </Grid>
        <TextBlock Text="2. Compte, PC et clavier" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,0"/>
        <CheckBox Content="Créer un compte local sans compte Microsoft ni mot de passe" ToolTipService.ShowOnDisabled="True" ToolTip="Ce mode de réinstallation utilise un compte local sans mot de passe. Ce choix est fixé par le profil." IsChecked="True" IsEnabled="False"/>
        <Grid Margin="22,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,8,0"><TextBlock Text="Nom du compte"/><TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="Nom du PC"/><TextBox Text="{Binding ComputerName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        </Grid>
        <TextBlock Text="Formats régionaux" Margin="0,16,0,0" FontWeight="SemiBold"/>
        <ComboBox x:Name="RegionCombo" DisplayMemberPath="Display" Margin="0,6,0,0" Padding="8" MinHeight="36"/>
        <TextBlock Text="Disposition du clavier" Margin="0,14,0,0" FontWeight="SemiBold"/>
        <ComboBox x:Name="KeyboardCombo" DisplayMemberPath="Display" Margin="0,6,0,0" Padding="8" MinHeight="36"/>
        <TextBlock x:Name="KeyboardHint" Foreground="#B6C2D2" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"/>
        <TextBlock Text="3. Nettoyage et confidentialité" FontSize="20" FontWeight="SemiBold" Margin="0,22,0,0"/>
        <CheckBox x:Name="CleanBastosCheckBox" Content="Installation propre personnalisée BASTOS" IsChecked="{Binding UseCleanBastosInstallation}"/>
        <TextBlock Text="Sans cette case, Windows est installé sans nettoyage Bastos. Avec cette case, le profil propre retire les applications ciblées et applique ses réglages de confidentialité. Windows Update, Sécurité Windows, Store, pilotes et composants de jeu sont conservés." Foreground="#B6C2D2" Margin="0,8,0,0" FontSize="12"/>
        <TextBlock Text="Le profil propre avec trois épingles est disponible pour Pro et Éducation. Pour Home, laisse cette case décochée." Foreground="#FCD34D" Margin="0,6,0,0" FontSize="12"/>
        <Expander Header="Voir le contenu du profil propre" Foreground="#EDF2F7" Margin="0,8,0,0"><StackPanel Margin="18,6,0,0"><TextBlock Text="Retirés lorsqu’ils sont présents : News, Météo, Outlook, Teams, Copilot, Cortana, OneDrive, hub Microsoft 365, OneNote, Contacts, courrier/calendrier, Skype, Conseils, Aide, Commentaires, Solitaire, Clipchamp, Power Automate, To Do, Cartes, Dev Home, Family, réalité mixte, applications 3D, Photos, Paint, Caméra, Enregistreur, lecteurs Musique/Vidéo, application Xbox et Game Bar, ainsi que les applications partenaires reconnues." FontSize="12"/><TextBlock Text="Conservés : Assistance rapide, Mobile connecté, Paramètres, Explorateur, Store, App Installer, Edge et WebView2, Bloc-notes, Calculatrice, capture d’écran, sécurité et maintenance Windows, réseau, audio, bibliothèques, codecs et composants nécessaires à l’authentification des jeux. Services désactivés : diagnostics DiagTrack, démonstration en magasin et cartes hors connexion. Réglages sauvegardés pour restauration. Aucun retrait profond de WinSxS, aucun blocage global des connexions Microsoft. Une reconnexion peut être nécessaire pour voir la disposition Démarrer." Margin="0,8,0,0" FontSize="12"/></StackPanel></Expander>
        <CheckBox x:Name="PreserveDriversCheckBox" Content="Conserver les pilotes tiers actuels pour la réinstallation" IsChecked="{Binding PreserveDrivers}"/>
        <TextBlock Text="Sauvegarde vérifiée sur D:, puis pilotes proposés à Windows pendant l’installation (Windows 11 24H2 ou ultérieur). Les applications constructeur et leurs réglages ne sont pas conservés. Cette option n’ajoute pas les pilotes au démarrage initial de WinPE." Foreground="#B6C2D2" Margin="0,8,0,0" FontSize="12"/>
        <CheckBox Content="Retirer les exigences TPM 2.0, Secure Boot et mémoire vive" IsChecked="{Binding BypassHardwareChecks}"/>
        <TextBlock Text="4. Partitions à conserver" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,0"/>
        <TextBlock Text="D: conserve son système NTFS et tous ses fichiers." Margin="0,8,0,0" Foreground="#B6C2D2"/>
        <CheckBox Content="Conserver uniquement D: sur le disque Windows ; recréer EFI, MSR et Windows" IsChecked="{Binding KeepOnlyRecoveryPartition}" Click="PartitionPlan_Click"/>
        <TextBlock Text="Si cette option est décochée, la partition EFI existante est également conservée." Margin="22,5,0,0" Foreground="#B6C2D2" FontSize="12"/>
        <TextBlock Text="Plan du disque" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,0"/>
        <TextBlock x:Name="PlanText" Margin="0,8,0,0" Foreground="#B6C2D2"/>
        <TextBlock Text="Ces options seront vérifiées avant le redémarrage. La réinstallation demandera une confirmation et effacera les partitions indiquées du disque Windows. Les autres disques restent intacts." Margin="0,12,0,0" Foreground="#FCD34D"/>
        <TextBlock Text="Générateur d’options adapté du code libre de Rufus • GPL v3 ou ultérieure" Margin="0,16,0,0" FontSize="11" Foreground="#94A3B8"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
