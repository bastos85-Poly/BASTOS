<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns:native="clr-namespace:Bastos.Native" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Bastos.Native.ExtraAppsPage">
  <UserControl.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,16,16" />
    </Style>
    <Style x:Key="Description" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,8,0,12" />
    </Style>
  </UserControl.Resources>
  <StackPanel IsEnabled="{Binding Available}">
    <Border Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Rendu des applications en arrière-plan" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="Choisissez séparément Chrome, Firefox ou Discord. Désactiver le rendu GPU peut accroître la charge CPU : aucun gain de FPS n’est garanti. Une seule relance de l’application est nécessaire après modification. Steam conserve son réglage existant ci-dessus. Fermez Discord avant de modifier son profil." Style="{StaticResource Description}" />
          <ComboBox ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}" DisplayMemberPath="Name" Margin="0,8" />
          <TextBlock Text="{Binding AppState}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,8" />
          <WrapPanel>
            <Button Content="Détecter / actualiser" Command="{Binding RefreshAppsCommand}" Margin="0,0,8,4">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                  <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </WrapPanel>
          <TextBlock Style="{DynamicResource ActionHint}" Text="{Binding ApplyAppCommand.DisabledReason}" />
          <native:OperationMessageView Text="{Binding AppStatus}" Foreground="{StaticResource AccentBrush}" Margin="0,8" />
        </StackPanel>
        <ContentControl Content="{Binding AppSwitch}" ContentTemplate="{StaticResource SettingSwitchVisual}" HorizontalContentAlignment="Stretch" Margin="24,0,0,0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="200" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>