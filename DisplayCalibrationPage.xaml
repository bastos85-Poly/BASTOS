<?xml version="1.0" ?><UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Bastos.Native.DisplayCalibrationPage">
 <StackPanel Margin="0,0,16,16">
  <Border Padding="16" CornerRadius="7" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10">
   <StackPanel>
    <TextBlock Text="Réglage de l’image" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock Text="Mires SDR pour régler l’écran à l’œil. Passe-les dans l’ordre, dans ta lumière habituelle : noirs, blancs, gamma, couleurs, puis uniformité." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/>
    <TextBlock Text="Avant de commencer : désactive temporairement le HDR dans Windows et sur l’écran, choisis un mode neutre ou sRGB, puis désactive les modes d’image dynamiques. Règle d’abord l’écran avec ses propres commandes." TextWrapping="Wrap"/>
    <TextBlock Text="Point de départ simple : valeurs neutres dans BASTOS, puis règle la luminosité physique de l’écran à ton confort. Gamma 1,00 ici signifie aucune correction logicielle ; ce n’est pas le gamma 2,2 que peut proposer le menu de l’écran." TextWrapping="Wrap" Margin="0,10,0,8"/>
    <TextBlock Text="Les cases ont des valeurs RVB exactes. Leur apparence dépend du profil Windows, du pilote et de l’écran ; seule une sonde mesure précisément la fidélité des couleurs." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
    <Button Content="Lancer les mires en plein écran" Tag="0" Click="OpenPattern" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" AutomationProperties.Name="Lancer les mires en plein écran"/>
   </StackPanel>
  </Border>
  <Border Padding="16" CornerRadius="7" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10">
   <StackPanel>
    <TextBlock Text="Commandes de l’écran" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock Text="Les ajustements sont provisoires jusqu’à Enregistrer. Vérifie le bureau avant de les conserver. Fermer BASTOS sans enregistrer restaure le dernier profil. Une fois enregistré, le profil est maintenu en arrière-plan pendant ta session Windows. Si EXFIL est installé, il est mis en pause pendant l’essai." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
    <Button Content="Retrouver une image neutre" Click="ResetNeutral" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
     <TextBlock Text="Gamma logiciel" VerticalAlignment="Center"/><Slider x:Name="GammaSlider" Grid.Column="1" Minimum="0.3" Maximum="2.8" Value="1" TickFrequency="0.01" SmallChange="0.01" ValueChanged="OnSliderChanged"/><TextBlock x:Name="GammaValue" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"/>
    </Grid>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
     <TextBlock Text="Luminosité logicielle" VerticalAlignment="Center"/><Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="-0.5" Maximum="0.5" Value="0" TickFrequency="0.01" SmallChange="0.01" ValueChanged="OnSliderChanged"/><TextBlock x:Name="BrightnessValue" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"/>
    </Grid>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
     <TextBlock Text="Contraste" VerticalAlignment="Center"/><Slider x:Name="ContrastSlider" Grid.Column="1" Minimum="0.5" Maximum="2" Value="1" TickFrequency="0.01" SmallChange="0.01" ValueChanged="OnSliderChanged"/><TextBlock x:Name="ContrastValue" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"/>
    </Grid>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
     <TextBlock Text="Vibrance" VerticalAlignment="Center"/><Slider x:Name="VibranceSlider" Grid.Column="1" Minimum="0" Maximum="200" Value="100" TickFrequency="1" SmallChange="1" ValueChanged="OnSliderChanged"/><TextBlock x:Name="VibranceValue" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"/>
    </Grid>
    <TextBlock Text="Gamma : au-dessus de 1,00, les tons moyens s’éclaircissent ; en dessous, ils s’assombrissent. Si tu hésites, laisse 1,00. La luminosité logicielle négative masque les détails noirs et le contraste trop élevé efface les blancs." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,4"/>
    <TextBlock x:Name="CalibrationGuidance" Foreground="#FFE8B66D" TextWrapping="Wrap" Margin="0,6,0,4"/>
    <TextBlock x:Name="ColorStatus" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,6,0,12" AutomationProperties.LiveSetting="Polite"/>
    <WrapPanel Margin="0,0,0,8">
     <Button Content="Voir le bureau" Click="ShowDesktop" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
     <Button Content="Enregistrer ce réglage" Click="SaveCurrent" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
     <Button Content="Revenir au dernier profil enregistré" Click="RestorePrevious" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>
    </WrapPanel>
    <TextBlock Text="Pour revenir à BASTOS après « Voir le bureau », clique sur son icône dans la barre des tâches. Si l’image est trop sombre ou les couleurs fausses, reviens au dernier profil au lieu d’enregistrer." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <Border Padding="16" CornerRadius="7" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
   <StackPanel>
    <TextBlock Text="Succession conseillée" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <Button Content="1 · Noirs — comparer d’abord 0, 16, 32 et 64, puis les détails 1 à 15" Tag="0" Click="OpenPattern" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
    <Button Content="2 · Blancs — comparer d’abord 192, 224, 240, 248 et 255" Tag="1" Click="OpenPattern" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
    <Button Content="3 · Gamma — comprendre les tons moyens, laisser 1,00 si incertain" Tag="2" Click="OpenPattern" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
    <Button Content="4 · Couleurs — vérifier les primaires, les gris et les teintes de peau" Tag="3" Click="OpenPattern" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
    <Button Content="5 · Uniformité — rechercher les teintes ou zones irrégulières" Tag="4" Click="OpenPattern" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left"/>
    <TextBlock Text="Dans les mires : ↑/↓ ajuste la luminosité sur les noirs, le contraste sur les blancs, le gamma sur les gris et la vibrance sur les couleurs. ←/→ navigue ; R restaure le profil précédent ; 1 à 3 change l’uniformité ; Échap quitte." Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
 </StackPanel>
</UserControl>
