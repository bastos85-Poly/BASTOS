<?xml version="1.0" ?><Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Bastos.Native.InstallationVerificationWindow" Title="Bastos — Bilan après réinstallation" Width="820" Height="760" MinWidth="650" MinHeight="480" WindowStartupLocation="CenterOwner" Background="#0B1020" Foreground="#F1F5FF">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18">
   <TextBlock Text="Bilan après réinstallation" FontSize="23" FontWeight="SemiBold"/>
   <TextBlock Text="Les réglages demandés sont comparés à Windows. Les nouveaux profils vérifient aussi les applications, la confidentialité et les widgets. Une autorisation administrateur est nécessaire pour contrôler tous les comptes et les applications provisionnées." TextWrapping="Wrap" Foreground="#AAB8CE" Margin="0,8,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,16">
   <TextBlock x:Name="VerificationSummary" Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#FFCF8C"/>
   <TextBlock Text="{Binding Date}" TextWrapping="Wrap" Foreground="#AAB8CE" Margin="0,8,0,0"/>
  </StackPanel>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ItemsControl ItemsSource="{Binding Checks}"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Padding="14" Margin="0,0,10,10" Background="#111B2E" BorderBrush="#263449" BorderThickness="1" CornerRadius="8">
     <StackPanel>
      <DockPanel><TextBlock Text="{Binding Label}" Foreground="{Binding Color}" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
      <TextBlock Text="{Binding Comparison}" Foreground="#D1DBEA" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <TextBlock Text="{Binding Detail}" Foreground="#AAB8CE" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </ScrollViewer>
  <DockPanel Grid.Row="3" Margin="0,16,0,0">
   <Button Content="Fermer" Click="Close_Click" DockPanel.Dock="Right" Style="{DynamicResource QuietButton}" Margin="12,0,0,0"/>
   <Button x:Name="RecheckInstallationButton" Content="Recontrôler Windows" Command="{Binding CheckCommand}" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left"/>
  </DockPanel>
 </Grid>
</Window>
