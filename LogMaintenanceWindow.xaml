<?xml version="1.0" ?><Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Bastos.Native.LogMaintenanceWindow" Title="Bastos — Journaux et fichiers temporaires" Width="1100" Height="850" MinWidth="800" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#0B1020" Foreground="#F1F5FF">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="105"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,15">
   <TextBlock Text="Journaux et fichiers temporaires" FontSize="23" FontWeight="SemiBold"/>
   <TextBlock Text="Prépare un aperçu du nettoyage des journaux locaux de Bastos. Aucun nettoyage automatique." Foreground="#AAB8CE" TextWrapping="Wrap" Margin="0,7,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Padding="12" Background="#111B2E" CornerRadius="8" Margin="0,0,10,0"><StackPanel><TextBlock Text="Taille analysée" Foreground="#AAB8CE"/><TextBlock Text="{Binding Total}" FontSize="20" Margin="0,6,0,0"/></StackPanel></Border>
   <Border Grid.Column="1" Padding="12" Background="#111B2E" CornerRadius="8" Margin="0,0,10,0"><StackPanel><TextBlock Text="Nettoyable (taille estimée)" Foreground="#AAB8CE"/><TextBlock Text="{Binding Cleanable}" FontSize="20" Foreground="#38D9A9" Margin="0,6,0,0"/></StackPanel></Border>
   <Border Grid.Column="2" Padding="12" Background="#111B2E" CornerRadius="8"><StackPanel><TextBlock Text="Conservé" Foreground="#AAB8CE"/><TextBlock Text="{Binding Preserved}" FontSize="20" Margin="0,6,0,0"/></StackPanel></Border>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,0,0,12">
   <WrapPanel IsEnabled="{Binding CanEdit}"><TextBlock Text="Conserver au moins" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="MaintenanceRetention" ItemsSource="{Binding RetentionChoices}" SelectedItem="{Binding KeepDays}" Width="85" Padding="6"/>
    <TextBlock Text="jours et les 200 opérations les plus récentes." VerticalAlignment="Center" Foreground="#AAB8CE" Margin="10,0,0,0"/></WrapPanel>
   <TextBlock Text="Erreurs, opérations incomplètes, reprise et fichiers utilisés : protégés." Foreground="#FFCF8C" TextWrapping="Wrap" Margin="0,9,0,0"/>
   <TextBlock Text="{Binding Summary}" Foreground="#AAB8CE" TextWrapping="Wrap" Margin="0,7,0,0"/>
  </StackPanel>
  <ListBox x:Name="MaintenanceItems" Grid.Row="3" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="#101624" BorderBrush="#263449" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding CanEdit}">
   <ListBox.ItemTemplate><DataTemplate><Grid Margin="8,9"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
    <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding Eligible}" VerticalAlignment="Top" Margin="0,4,0,0"/>
    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" Foreground="#F1F5FF" FontWeight="SemiBold"/><TextBlock Text="{Binding Reason}" Foreground="#AAB8CE" TextWrapping="Wrap" Margin="0,6,8,0"/></StackPanel>
    <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding Size}" Foreground="#D1DBEA"/><TextBlock Text="{Binding State}" Foreground="#FFCF8C" Margin="0,6,0,0"/></StackPanel>
   </Grid></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <TextBox Grid.Row="4" Text="{Binding SelectedInventory, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="#111827" Foreground="#AAB8CE" BorderBrush="#263449" Padding="10" Margin="0,10,0,0"/>
  <StackPanel Grid.Row="5" Margin="0,12,0,0"><TextBox x:Name="MaintenanceStatus" Text="{Binding Status, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#FFCF8C" TextWrapping="Wrap" Padding="0" Margin="0,0,0,12"/>
   <TextBlock Style="{DynamicResource ActionHint}" Text="{Binding CleanDisabledReason}"/>
   <DockPanel><Button Content="Fermer" Click="Close_Click" ToolTip="Attends la fin de l’opération avant de fermer cette fenêtre." IsEnabled="{Binding CanEdit}" Style="{DynamicResource QuietButton}" DockPanel.Dock="Right" Margin="12,0,0,0"/>
    <WrapPanel><Button x:Name="MaintenanceAnalyzeButton" Content="Analyser / actualiser" Command="{Binding AnalyzeCommand}" Style="{DynamicResource PrimaryButton}" Margin="0,0,12,0"/>
     <Button x:Name="MaintenanceCleanButton" ToolTip="{Binding CleanDisabledReason}" AutomationProperties.HelpText="{Binding CleanDisabledReason}" Content="Nettoyer les éléments cochés…" Click="Clean_Click" IsEnabled="{Binding CanClean}" Style="{DynamicResource DestructiveButton}"/></WrapPanel>
   </DockPanel>
  </StackPanel>
 </Grid>
</Window>