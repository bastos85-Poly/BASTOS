<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns:native="clr-namespace:Bastos.Native" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Bastos.Native.CursorPackPage">
  <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16" CornerRadius="7" Margin="0,0,0,10">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Curseurs sombres" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="W11 Cursor Dark Free — par Jepri Creations" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,6" />
        <TextBlock Margin="0,0,0,10">
          <Hyperlink NavigateUri="https://www.deviantart.com/jepricreations" RequestNavigate="OpenAuthor">Page de l’auteur et crédits</Hyperlink>
        </TextBlock>
        <TextBlock Text="Active les 17 curseurs du pack fourni avec Bastos, dont les animations d’attente. Le choix est enregistré pour votre compte Windows et conservé après redémarrage. Votre thème précédent est sauvegardé avant la première activation." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
        <TextBlock Style="{DynamicResource ActionHint}" Text="{Binding ApplyCommand.DisabledReason}" />
        <native:OperationMessageView Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" Margin="0,12" />
        <WrapPanel>
          <Button Content="Actualiser l’état" Command="{Binding RefreshCommand}" Style="{DynamicResource QuietButton}" Margin="0,0,0,4" />
        </WrapPanel>
      </StackPanel>
      <ContentControl Content="{Binding PackSwitch}" ContentTemplate="{StaticResource SettingSwitchVisual}" HorizontalContentAlignment="Stretch" Margin="24,0,0,0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="200" />
    </Grid>
  </Border>
</UserControl>