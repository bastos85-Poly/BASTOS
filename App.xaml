<?xml version="1.0" encoding="utf-8"?>
<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:native="clr-namespace:Bastos.Native" x:Class="Bastos.Native.App">
  <Application.Resources>
    <ResourceDictionary>
      <native:SettingCardSpanConverter x:Key="SettingCardSpanConverter" />
      <native:ButtonRoleConverter x:Key="ButtonRoleConverter" />
      <native:AvailabilityTooltipConverter x:Key="AvailabilityTooltipConverter" />
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <Style x:Key="KeyboardFocusRing" TargetType="Control">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Control">
              <Border Margin="-3" CornerRadius="9" BorderThickness="2" BorderBrush="#9ACFFF" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <SolidColorBrush x:Key="WindowBrush" Color="#0B1018" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#0B1018" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#151E2C" />
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1D2A3C" />
      <SolidColorBrush x:Key="BorderBrush" Color="#2C3C51" />
      <SolidColorBrush x:Key="AccentBrush" Color="#70B7FF" />
      <SolidColorBrush x:Key="TextBrush" Color="#F3F6FF" />
      <SolidColorBrush x:Key="MutedBrush" Color="#B2C0D3" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#36D399" />
      <SolidColorBrush x:Key="WarningBrush" Color="#FFB84D" />
      <SolidColorBrush x:Key="DangerBrush" Color="#FF6174" />
      <Style x:Key="{x:Type Window}" TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource WindowBrush}" />
      </Style>
      <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, FallbackValue={StaticResource TextBrush}}" />
      </Style>
      <Style x:Key="{x:Type ToolTip}" TargetType="{x:Type ToolTip}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="#10182A" />
        <Setter Property="BorderBrush" Value="#35405D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="ToolTip.Placement" Value="Mouse" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToolTip}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Control.Padding}">
                <TextBlock Text="{TemplateBinding ContentControl.Content}" Foreground="{TemplateBinding Control.Foreground}" TextWrapping="Wrap" FontSize="12" LineHeight="18" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DarkComboBoxItem" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBoxItem}">
              <Border Name="ItemRoot" Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="ItemRoot" Property="Border.Background" Value="#1D2A48" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="ItemRoot" Property="Border.Background" Value="{StaticResource AccentBrush}" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="#35405D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="ComboBox.MaxDropDownHeight" Value="360" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid>
                <Border Name="ComboRoot" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="6" />
                <ToggleButton Focusable="False" ClickMode="Press" Background="#00FFFFFF" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                      <Border Background="#00FFFFFF">
                        <Path Data="M0,0 L5,5 L10,0" Width="10" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Fill="{StaticResource MutedBrush}" />
                      </Border>
                    </ControlTemplate>
                  </Control.Template>
                </ToggleButton>
                <ContentPresenter Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" />
                <Popup Name="Popup" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                  <Border Margin="0,3,0,0" BorderBrush="#35405D" BorderThickness="1" CornerRadius="6" Background="{StaticResource SurfaceBrush}" Width="{Binding ActualWidth, ElementName=ComboRoot}">
                    <ScrollViewer MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="ComboRoot" Property="Border.BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="ComboRoot" Property="Border.BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="UIElement.Opacity" Value="0.55" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextBoxBase.CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Padding" Value="9,7" />
      </Style>
      <Style x:Key="NavItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border Name="Root" Background="{TemplateBinding Control.Background}" BorderBrush="Transparent" BorderThickness="3,0,0,0" CornerRadius="8" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Root" Property="Border.Background" Value="{StaticResource SurfaceHoverBrush}" />
                </Trigger>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="Root" Property="Border.Background" Value="#1B304A" />
                  <Setter TargetName="Root" Property="Border.BorderBrush" Value="{StaticResource AccentBrush}" />
                  <Setter Property="Foreground" Value="#D5EBFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type Expander}" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Expander">
              <StackPanel>
                <ToggleButton x:Name="HeaderToggle" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" HorizontalContentAlignment="Stretch" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Padding="2,7" FocusVisualStyle="{StaticResource KeyboardFocusRing}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Path x:Name="Chevron" Data="M 0,0 L 4,4 L 0,8" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                          <ContentPresenter Grid.Column="1" ContentSource="Content" RecognizesAccessKey="True" />
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Chevron" Property="RenderTransform">
                            <Setter.Value>
                              <RotateTransform Angle="90" />
                            </Setter.Value>
                          </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                          <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="ExpandContent" Visibility="Collapsed" Margin="{TemplateBinding Padding}" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                  <Setter TargetName="ExpandContent" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ActionHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Margin" Value="0,6,0,8" />
        <Style.Triggers>
          <Trigger Property="Text" Value="">
            <Setter Property="Visibility" Value="Collapsed" />
          </Trigger>
          <Trigger Property="Text" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="ToolTip" Value="{Binding Command.DisabledReason, RelativeSource={RelativeSource Self}, Converter={StaticResource AvailabilityTooltipConverter}}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding Command.DisabledReason, RelativeSource={RelativeSource Self}, FallbackValue=''}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Background" Value="#245FC7" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonRoleConverter}}" Value="auxiliary">
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonRoleConverter}}" Value="destructive">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
      </Style>
      <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonRoleConverter}}" Value="auxiliary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="DestructiveButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
      <Style x:Key="PrimaryChoiceButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding IsChoiceCard}" Value="False" />
              <Condition Binding="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonRoleConverter}}" Value="primary" />
            </MultiDataTrigger.Conditions>
            <Setter Property="Background" Value="#245FC7" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
          </MultiDataTrigger>
          <DataTrigger Value="True" Binding="{Binding IsPrimarySelected}">
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SecondaryChoiceButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsSecondarySelected}">
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="BastosToggle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="#343B50" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Track" Background="{TemplateBinding Control.Background}" CornerRadius="13">
                <Ellipse Name="Thumb" Width="18" Height="18" Fill="#E8EDFA" HorizontalAlignment="Left" Margin="4,0,0,0" />
              </Border>
              <ControlTemplate.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsOn}">
                  <Setter TargetName="Track" Property="Border.Background" Value="{StaticResource AccentBrush}" />
                  <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                  <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
                  <Setter TargetName="Thumb" Property="Shape.Fill" Value="#FFFFFFFF" />
                </DataTrigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Track" Property="UIElement.Opacity" Value="0.86" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding IsBusy}">
                  <Setter TargetName="Track" Property="UIElement.Opacity" Value="0.5" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="GuidedTabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,20,0,0" />
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="TabItem">
              <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Padding" Value="15,10" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Step" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="0,0,8,0">
                      <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter TargetName="Step" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Step" Property="Background" Value="{StaticResource SurfaceBrush}" />
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.55" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SettingsPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,10" />
      </Style>
      <native:SoftwareColumnsConverter x:Key="SoftwareColumnsConverter" />
      <DataTemplate x:Key="SettingSwitchVisual">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding ToggleLabel}" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Grid.Column="0" HorizontalAlignment="Right" MaxWidth="140" TextWrapping="Wrap" TextAlignment="Right" />
          <native:ConfirmedToggleButton Width="50" Height="26" IsChecked="{Binding ToggleState, Mode=OneWay}" IsThreeState="True" Command="{Binding ToggleCommand}" Cursor="Hand" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding ToggleHelp}" ToolTip="{Binding ToggleHelp}" ToolTipService.ShowOnDisabled="True" FocusVisualStyle="{StaticResource KeyboardFocusRing}" Grid.Column="1">
            <native:ConfirmedToggleButton.Template>
              <ControlTemplate TargetType="native:ConfirmedToggleButton">
                <Border x:Name="Track" CornerRadius="13" Background="#43516A" BorderBrush="#72839C" BorderThickness="1">
                  <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#F3F6FF" HorizontalAlignment="Left" Margin="3,0,0,0" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Track" Property="Background" Value="#245FC7" />
                    <Setter TargetName="Track" Property="BorderBrush" Value="#70B7FF" />
                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                  </Trigger>
                  <Trigger Property="IsChecked" Value="{x:Null}">
                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Center" />
                    <Setter TargetName="Thumb" Property="Margin" Value="0" />
                    <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Track" Property="BorderBrush" Value="#D5EBFF" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </native:ConfirmedToggleButton.Template>
          </native:ConfirmedToggleButton>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="StatusCardActions">
        <Grid>
          <StackPanel Orientation="Horizontal" Visibility="{Binding ShowPairedButtons, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" Style="{StaticResource PrimaryChoiceButton}" Margin="0,0,8,4" />
            <Button Content="{Binding SecondaryText}" Command="{Binding SecondaryCommand}" Style="{StaticResource SecondaryChoiceButton}" Margin="0,0,0,4" />
          </StackPanel>
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SettingSwitchVisual}" HorizontalContentAlignment="Stretch" Margin="0" Visibility="{Binding IsToggleCard, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
