              </Expander.Style>
              <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="{Binding Description}" Margin="0,6,0,6" />
            </Expander>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="{Binding IsToggleCard, Converter={StaticResource SettingCardSpanConverter}}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="{Binding Description}" Margin="0,8,0,12">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.CurrentPage.Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Réparation">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <native:OperationMessageView Detail="{Binding StateDetail}" Grid.Row="2" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Text="{Binding State}" Grid.ColumnSpan="{Binding IsToggleCard, Converter={StaticResource SettingCardSpanConverter}}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type native:OperationMessageView}">
                  <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                  <Style.Triggers>
                    <DataTrigger Value="{x:Static models:StatusTone.Success}" Binding="{Binding Tone}">
                      <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Value="{x:Static models:StatusTone.Warning}" Binding="{Binding Tone}">
                      <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Value="{x:Static models:StatusTone.Danger}" Binding="{Binding Tone}">
                      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
