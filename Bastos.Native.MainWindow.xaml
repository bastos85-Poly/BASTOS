            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0" Visibility="{Binding ShowStandardActions, Converter={StaticResource BooleanToVisibilityConverter}}" Grid.ColumnSpan="{Binding IsToggleCard, Converter={StaticResource SettingCardSpanConverter}}">
              <Button Style="{StaticResource PrimaryButton}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" Visibility="{Binding HasPrimaryAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
              <Button Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" Content="{Binding SecondaryText}" Command="{Binding SecondaryCommand}" Visibility="{Binding HasSecondaryAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <ContentControl Visibility="{Binding ShowChoiceActions, Converter={StaticResource BooleanToVisibilityConverter}}" Content="{Binding}" ContentTemplate="{StaticResource StatusCardActions}" HorizontalContentAlignment="Stretch">
              <ContentControl.Style>
                <Style TargetType="ContentControl">
                  <Setter Property="Grid.Row" Value="4" />
                  <Setter Property="Grid.Column" Value="0" />
                  <Setter Property="Grid.ColumnSpan" Value="2" />
                  <Setter Property="Margin" Value="0,14,0,0" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsToggleCard}" Value="True">
                      <Setter Property="Grid.Row" Value="0" />
