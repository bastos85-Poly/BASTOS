              <Expander.Style>
                <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.CurrentPage.Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Réparation">
                      <Setter Property="Visibility" Value="Collapsed" />
