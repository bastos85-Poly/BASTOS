                <TextBlock Text="{Binding HelpText}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
              </Expander>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource BastosToggle}" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding ToggleCommand}" />
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate DataType="{x:Type models:TroubleshootingChoice}" x:Key="ClassifiedChoice">
        <Border Style="{StaticResource SettingsPanel}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,10">
              <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
              <Expander Header="Détails" Margin="0,6,0,4">
                <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,14,0" Text="{Binding Description}" />
              </Expander>
              <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,14,0" Text="{Binding RecommendationText}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsRecommendationMet}">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
            </StackPanel>
            <ComboBox Grid.Column="0" VerticalAlignment="Center" ItemsSource="{Binding Values}" SelectedItem="{Binding SelectedValue, Mode=TwoWay}" Grid.Row="1" />
            <Button Grid.Column="2" Content="Appliquer" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Command="{Binding ApplyCommand}" Grid.Row="1" />
            <native:OperationMessageView Grid.Column="0" Grid.ColumnSpan="3" Foreground="{StaticResource AccentBrush}" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,8,0,0" Text="{Binding State}" Grid.Row="2" />
          </Grid>
        </Border>
