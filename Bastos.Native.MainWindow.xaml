      <DataTemplate x:Key="CompactMetricTemplate" DataType="{x:Type models:PerformanceMetric}">
        <Border Margin="0,0,16,0" Padding="17" MinHeight="108" CornerRadius="7" Background="#101624" BorderBrush="#28334C" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="9" Height="9" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,9,0" Background="{Binding Accent}" />
