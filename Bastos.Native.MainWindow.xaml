      <DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:native="clr-namespace:Bastos.Native" x:Key="ClassifiedGroup">
        <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Padding="10" Background="Transparent">
          <StackPanel Margin="0,12,0,0" TextElement.FontSize="13" TextElement.FontWeight="Normal">
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14" />
            <ItemsControl ItemsSource="{Binding Choices}" ItemTemplate="{StaticResource ClassifiedChoice}" />
            <ItemsControl ItemsSource="{Binding Toggles}" ItemTemplate="{StaticResource ClassifiedToggle}" />
            <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ClassifiedCard}" />
            <ContentControl>
              <ContentControl.Style>
                <Style TargetType="ContentControl">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasMouse}" Value="True">
                      <Setter Property="ContentTemplate">
                        <Setter.Value>
                          <DataTemplate>
                            <native:MouseSettingsPage />
                          </DataTemplate>
                        </Setter.Value>
                      </Setter>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ContentControl.Style>
            </ContentControl>
          </StackPanel>
        </Expander>
      </DataTemplate>
