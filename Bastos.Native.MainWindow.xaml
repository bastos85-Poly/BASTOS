    <native:OperationMessageView Text="{Binding State}" Detail="{Binding StateDetail}" Margin="0,7,0,0">
 <native:OperationMessageView.Style><Style TargetType="native:OperationMessageView"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Tone}" Value="{x:Static models:StatusTone.Warning}"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="{x:Static models:StatusTone.Danger}"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></native:OperationMessageView.Style>
