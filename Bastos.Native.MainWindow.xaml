              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock FontWeight="SemiBold" FontSize="16" Text="{Binding Title}" Grid.ColumnSpan="{Binding IsToggleCard, Converter={StaticResource SettingCardSpanConverter}}" />
