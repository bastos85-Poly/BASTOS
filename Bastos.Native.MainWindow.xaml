              </Expander>
              <native:OperationMessageView Detail="{Binding StateDetail}" Text="{Binding State}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
            </StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusCardActions}" HorizontalContentAlignment="Stretch">
              <ContentControl.Style>
                <Style TargetType="ContentControl">
                  <Setter Property="Grid.Row" Value="1" />
                  <Setter Property="Grid.Column" Value="0" />
                  <Setter Property="Grid.ColumnSpan" Value="2" />
                  <Setter Property="Margin" Value="0,14,0,0" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsToggleCard}" Value="True">
                      <Setter Property="Grid.Row" Value="0" />
                      <Setter Property="Grid.Column" Value="1" />
                      <Setter Property="Grid.ColumnSpan" Value="1" />
                      <Setter Property="Grid.RowSpan" Value="1" />
                      <Setter Property="Margin" Value="24,0,0,0" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                      <Setter Property="HorizontalAlignment" Value="Right" />
                      <Setter Property="MaxWidth" Value="200" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ContentControl.Style>
            </ContentControl>
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate DataType="{x:Type models:TroubleshootingToggle}" x:Key="ClassifiedToggle">
        <Border Style="{StaticResource SettingsPanel}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="68" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}" />
              <Expander Header="Détails" Margin="0,6,0,4">
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,7,8,0" Text="{Binding Description}" />
              </Expander>
              <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,12,0" Text="{Binding RecommendationText}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsRecommendationMet}">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
              <native:OperationMessageView Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,5,12,0" Text="{Binding State}" />
