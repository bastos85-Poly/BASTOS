                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="BrowserTileBorder" Property="Border.BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="BrowserTileBorder" Property="Border.Background" Value="#202C49" />
                  <Setter TargetName="BrowserTileBorder" Property="Border.BorderBrush" Value="{StaticResource AccentBrush}" />
