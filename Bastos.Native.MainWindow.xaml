            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <native:OperationMessageView Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="16,0,0,0" Text="{Binding State}" />
            </StackPanel>
          </StackPanel>
          <Border Padding="14" CornerRadius="8" Background="#10182A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,16,0,0">
            <native:OperationMessageView Foreground="{StaticResource AccentBrush}" Text="{Binding TweakingStatus}" />
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Row="1" Visibility="{Binding CurrentPage.IsTroubleshooting, Converter={StaticResource BooleanToVisibilityConverter}}" x:Name="PersonalizationPageScroll">
        <StackPanel Margin="0,0,8,0">
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Préférences Windows par thème" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Actualiser l’état" Style="{DynamicResource QuietButton}" Command="{Binding RefreshCommand}" />
          </Grid>
          <Expander Header="Curseurs" FontSize="16" FontWeight="SemiBold" Padding="10" Margin="0,0,0,10">
            <native:CursorPackPage DataContext="{Binding CursorPack}" FontSize="13" FontWeight="Normal" Margin="0,12,0,0" />
          </Expander>
          <Expander Header="Profils d’apparence" FontSize="16" FontWeight="SemiBold" Padding="10" Margin="0,0,0,10">
            <native:AppearanceProfilesPage DataContext="{Binding Extras}" FontSize="13" FontWeight="Normal" Margin="0,12,0,0" />
          </Expander>
          <ItemsControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" ItemsSource="{Binding PersonalizationGroups}" ItemTemplate="{StaticResource ClassifiedGroup}" />
          <TextBlock Text="Compte administrateur" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,10" />
          <Border Style="{StaticResource SettingsPanel}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,10">
                <TextBlock Text="Définir le nom complet de l’administrateur" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="Modifie le nom d’affichage du compte Windows actuel sans changer son identifiant." Foreground="{StaticResource MutedBrush}" Margin="0,6,14,0" TextWrapping="Wrap" />
              </StackPanel>
              <TextBox Grid.Column="0" VerticalAlignment="Center" MaxLength="64" Text="{Binding AdministratorFullName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" />
              <Button Grid.Column="2" Content="Appliquer" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Command="{Binding SetAdministratorFullNameCommand}" Grid.Row="1" />
            </Grid>
          </Border>
          <Border Padding="14" CornerRadius="8" Background="#10182A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,16,0,0">
            <native:OperationMessageView Foreground="{StaticResource AccentBrush}" Text="{Binding TroubleshootingStatus}" />
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Row="1" Visibility="{Binding CurrentPage.IsReinstall, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel Margin="0,0,8,0" DataContext="{Binding Reinstall}">
          <Border Padding="16" CornerRadius="9" Background="#10182A" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Margin="0,0,0,16">
            <StackPanel>
              <native:OperationMessageView Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Text="{Binding Status}" />
              <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
          </Border>
          <TabControl x:Name="ReinstallSteps" Style="{StaticResource GuidedTabs}">
            <TabItem Header="1 · Windows" x:Name="ReinstallWindowsStep">
              <StackPanel>
                <WrapPanel Margin="0,0,0,16">
                  <Button Content="J’ai déjà mon ISO · Continuer" Style="{StaticResource SecondaryButton}" Click="ReinstallNext_Click" />
                </WrapPanel>
                <Border Padding="16" CornerRadius="7" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="Quel Windows télécharger ?" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Choisis le fichier ISO à télécharger dans le catalogue Massgrave." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,16" />
                    <Grid IsEnabled="{Binding IsCatalogReady}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="2*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <StackPanel>
                        <TextBlock Text="Famille Windows" Margin="0,0,0,6" />
                        <ComboBox x:Name="IsoFamilyCombo" DisplayMemberPath="Display" ItemsSource="{Binding CatalogFamilies}" SelectedItem="{Binding SelectedCatalogFamily}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="Version et édition de l’ISO" Margin="0,0,0,6" />
                        <ComboBox x:Name="IsoVersionCombo" DisplayMemberPath="Display" ItemsSource="{Binding CatalogVersions}" SelectedItem="{Binding SelectedCatalogVersion}" />
                      </StackPanel>
                      <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <TextBlock Text="Langue de l’ISO" Margin="0,0,0,6" />
                        <ComboBox x:Name="IsoLanguageCombo" DisplayMemberPath="Display" ItemsSource="{Binding CatalogLanguages}" SelectedItem="{Binding SelectedCatalogLanguage}" IsEnabled="{Binding CanChooseCatalogLanguage}" />
                        <TextBlock Text="{Binding CatalogLanguageHint}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0" Visibility="{Binding HasCatalogLanguageFallback, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </StackPanel>
                      <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
                        <TextBlock Text="Architecture" Margin="0,0,0,6" />
                        <ComboBox x:Name="IsoArchitectureCombo" DisplayMemberPath="Display" ItemsSource="{Binding CatalogArchitectures}" SelectedItem="{Binding SelectedCatalogArchitecture}" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding HasCatalogVariants, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <TextBlock Text="Disque / fichier ISO" Margin="0,0,0,6" />
                      <ComboBox DisplayMemberPath="FileName" ItemsSource="{Binding CatalogImages}" SelectedItem="{Binding SelectedCatalogIso}" />
                    </StackPanel>
                    <Border Background="Transparent" CornerRadius="8" Padding="0,8" Margin="0,17,0,0" BorderThickness="0">
                      <StackPanel>
                        <TextBlock Text="ISO sélectionnée" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CatalogSelectionSummary}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                        <Expander Header="Nom du fichier" Margin="0,8,0,6">
                          <TextBlock Text="{Binding CatalogFileName}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0" />
                        </Expander>
                      </StackPanel>
                    </Border>
                    <WrapPanel Margin="0,14,0,0">
                      <Button Content="Télécharger l’ISO choisie…" Style="{StaticResource PrimaryButton}" Command="{Binding DownloadCommand}" Margin="0,0,9,8" />
                    </WrapPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,3,0,8" Visibility="{Binding IsCatalogRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Expander Header="Source et détails du téléchargement" Margin="0,10,0,0">
                      <StackPanel>
                        <TextBlock Text="{Binding CatalogStatus}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                        <TextBlock Text="Le fichier choisi s’ouvre dans ton navigateur. Enregistre l’ISO dans Téléchargements, puis reviens dans Bastos. Une validation de l’hébergeur peut être nécessaire." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding CatalogCompatibilityHint}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock Text="ISO complètes uniquement : les correctifs DVP des anciennes versions ne sont pas inclus." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" />
                        <Button Content="Actualiser le catalogue" Style="{DynamicResource QuietButton}" Command="{Binding RefreshCatalogCommand}" Margin="0,5,0,0" HorizontalAlignment="Left" />
                        <Button Content="Voir la rubrique source" Style="{StaticResource SecondaryButton}" Command="{Binding OpenCatalogSourceCommand}" Margin="0,5,0,0" HorizontalAlignment="Left" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </Border>
              </StackPanel>
            </TabItem>
            <TabItem Header="2 · Mon ISO" x:Name="ReinstallIsoStep">
              <StackPanel>
                <Border Padding="16" CornerRadius="7" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="2. Méthode d’installation" FontSize="16" FontWeight="SemiBold" />
                    <ComboBox DisplayMemberPath="Display" Margin="0,12,0,0" ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}" />
                  </StackPanel>
                </Border>
                <StackPanel Visibility="{Binding IsUsbMethod, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock Text="ISO Windows à utiliser" Margin="0,12,0,5" />
                  <ComboBox ItemsSource="{Binding Isos}" SelectedItem="{Binding SelectedIso}" IsEnabled="{Binding CanChooseLocalIso}" />
                  <Button Content="Ouvrir le dossier ISO" Style="{DynamicResource QuietButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding OpenLibraryCommand}" />
                </StackPanel>
                <Border Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0" CornerRadius="8" Padding="0,8" Margin="0,0,0,13" Visibility="{Binding IsRecoveryMethod, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <StackPanel>
                    <TextBlock Text="Choisir l’ISO à placer dans BASTOS_RECOVERY" FontWeight="SemiBold" />
                    <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Isos}" SelectedItem="{Binding SelectedIso}" IsEnabled="{Binding CanChooseLocalIso}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,3">
                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Display}" />
                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="{Binding Metadata}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <Button Content="Actualiser la liste des ISO" Style="{DynamicResource QuietButton}" Command="{Binding RefreshIsoCommand}" />
                      <Button Content="Ouvrir le dossier ISO" Style="{DynamicResource QuietButton}" Margin="9,0,0,0" Command="{Binding OpenLibraryCommand}" />
                      <Button Content="Supprimer l’ISO sélectionnée" Style="{DynamicResource DestructiveButton}" Margin="9,0,0,0" Command="{Binding DeleteIsoCommand}" />
                    </StackPanel>
                    <Expander Header="Détails de l’ISO" Margin="0,8,0,0">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Text="{Binding SelectedRecoveryIsoTitle}" />
                        <TextBlock Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" Text="{Binding SelectedRecoveryIsoKind}" />
                        <TextBlock Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,5,0,0" Text="{Binding SelectedRecoveryIsoMetadata}" />
                        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" Text="{Binding SelectedRecoveryIsoPath}" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </Border>
                <WrapPanel Margin="0,4,0,8">
                  <Button Content="Retour" Style="{DynamicResource QuietButton}" Click="ReinstallBack_Click" Margin="0,0,8,0" />
                  <Button Content="Continuer vers les options" Style="{StaticResource PrimaryButton}" Click="ReinstallNext_Click" />
                </WrapPanel>
              </StackPanel>
            </TabItem>
            <TabItem Header="3 · Options et lancement" x:Name="ReinstallLaunchStep">
              <StackPanel>
                <Border Padding="16" CornerRadius="7" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16" Visibility="{Binding IsUsbMethod, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <StackPanel>
                    <TextBlock Text="Clé USB bootable avec Rufus" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Rufus est téléchargé depuis sa publication officielle, sa signature est vérifiée et l’ISO sélectionnée est présélectionnée. Rufus te demande ensuite la clé à effacer avant l’écriture." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,14" />
                    <Button Content="Préparer la clé USB avec Rufus" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Command="{Binding PrepareUsbCommand}" />
                    <TextBlock Style="{StaticResource ActionHint}" Text="{Binding PrepareUsbCommand.DisabledReason}" />
                  </StackPanel>
                </Border>
                <Border Padding="16" CornerRadius="7" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16" Visibility="{Binding IsRecoveryMethod, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <StackPanel>
                    <TextBlock Text="Réinstaller sur ce PC" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Bastos prépare les fichiers, les vérifie, puis lance la réinstallation après votre confirmation." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,14" />
                    <Border Background="Transparent" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0" CornerRadius="8" Padding="0,8" Margin="0,0,0,13">
                      <StackPanel>
                        <TextBlock Text="1. Préparer la récupération" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="Vérifie le disque, puis crée D: BASTOS_RECOVERY. Le choix de l’édition et la copie de l’ISO se feront ensuite. Cette étape ne redémarre pas le PC." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12" TextWrapping="Wrap" />
                        <WrapPanel>
                          <Button Content="Vérifier la compatibilité" Command="{Binding CheckRecoveryCompatibilityCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                          <Button Content="Créer D: BASTOS_RECOVERY" Command="{Binding InitializeRecoveryCommand}" Style="{StaticResource SecondaryButton}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource ActionHint}" Text="{Binding InitializeRecoveryCommand.DisabledReason}" />
                      </StackPanel>
                    </Border>
                    <Border Background="Transparent" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0" CornerRadius="8" Padding="0,8" Margin="0,0,0,13">
                      <StackPanel>
                        <TextBlock Text="2. Vérifiez vos options" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="{Binding RufusOptionsSummary}" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12" TextWrapping="Wrap" />
                        <Button Content="Compte, clavier et partitions…" Command="{Binding RufusOptionsCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
                      </StackPanel>
                    </Border>
                    <Button Content="Lancer la réinstallation" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Command="{Binding BootRecoveryCommand}" />
                    <TextBlock Style="{StaticResource ActionHint}" Text="{Binding BootRecoveryCommand.DisabledReason}" />
                    <TextBlock Text="Enregistre tes fichiers avant de lancer. Le récapitulatif précisera les partitions conservées et effacées avant ta confirmation." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <Border Background="Transparent" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0" CornerRadius="8" Padding="0,14" Margin="0,14,0,0">
                      <StackPanel>
                        <TextBlock Text="Après la réinstallation" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="Quand Windows et Bastos fonctionnent depuis C:, vérifie D: puis récupère son espace. Bastos conserve une petite partition de réparation Windows." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12" TextWrapping="Wrap" />
                        <Button Content="Récupérer l’espace de D: dans C:" Command="{Binding FinalizeRecoveryCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource ActionHint}" Text="{Binding FinalizeRecoveryCommand.DisabledReason}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
            </TabItem>
          </TabControl>
          <Border Background="#11182A" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,13,0,0" Visibility="{Binding IsRecoveryProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
              <DockPanel>
                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding RecoveryProgressPhase}" />
                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding RecoveryProgressPercent, StringFormat={}{0:N0} %}" />
              </DockPanel>
              <ProgressBar Height="16" Minimum="0" Maximum="100" Margin="0,9,0,0" Value="{Binding RecoveryProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding IsRecoveryProgressIndeterminate, Mode=OneWay}" />
              <native:OperationMessageView Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" Text="{Binding RecoveryProgressText}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="2" Margin="0,12,0,0" DataContext="{Binding Reinstall}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="1" Margin="12,0,0,0" Padding="10" Background="#11182A" CornerRadius="8" Visibility="{Binding IsCancellationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CancellationRequestButton" Content="Demander l’annulation" Command="{Binding CancelOperationCommand}" ToolTip="{Binding CancellationHint}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock x:Name="CancellationHintText" Grid.Column="1" Text="{Binding CancellationHint}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Button Content="Actualiser" Style="{DynamicResource QuietButton}" Width="130" VerticalAlignment="Center" Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
      </Grid>
    </Grid>
  </Grid>
</Window>
