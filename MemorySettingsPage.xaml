<?xml version="1.0" ?><UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Bastos.Native.MemorySettingsPage">
 <Border Padding="16" Margin="0,0,16,16" CornerRadius="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
  <StackPanel>
   <TextBlock Text="Liste standby" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock Text="Vide les données en cache de la liste standby. Windows gère normalement cette mémoire automatiquement ; ce nettoyage ponctuel ne garantit pas un gain de performances." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,18"/>
   <Button x:Name="ClearButton" Content="Vider la liste standby" Click="ClearStandby" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" AutomationProperties.Name="Vider la liste standby"/>
   <ProgressBar x:Name="BusyIndicator" Height="4" Margin="0,14,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
   <TextBlock x:Name="ResultText" Text="À la demande · autorisation administrateur requise" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
 </Border>
</UserControl>